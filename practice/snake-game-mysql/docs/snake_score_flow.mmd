flowchart TD
    A["用户操作<br/>点击难度按钮 / 方向键 / 空格暂停 / R返回菜单"] --> B["Pygame 事件处理: Game.handle_events()<br/>同步阻塞: 必须在主循环中立即处理输入"]
    B --> C["更新方向、暂停状态、难度和游戏状态<br/>同步阻塞: 游戏状态必须一致"]
    C --> D["游戏循环调用 Game.update()<br/>同步阻塞: 每帧推进游戏逻辑"]

    D --> E{"游戏是否处于运行状态?"}
    E -- "否: 菜单/暂停/已结束" --> F["跳过移动和碰撞计算<br/>同步阻塞: 耗时短"]
    E -- "是" --> G["Snake.move()<br/>同步阻塞: 移动蛇头和身体"]

    G --> H{"是否吃到食物?"}
    H -- "是" --> I["score += 10<br/>蛇增长、刷新食物、可能提升速度<br/>同步阻塞: 游戏核心逻辑"]
    H -- "否" --> J["保持当前分数<br/>同步阻塞"]
    I --> K["碰撞检测<br/>边界碰撞 / 自身碰撞<br/>同步阻塞"]
    J --> K

    K --> L{"是否游戏结束?"}
    L -- "否" --> M["Game.draw()<br/>显示当前分数和历史最高分<br/>同步阻塞: 每帧渲染"]
    L -- "是" --> N["设置 game_over = True<br/>同步阻塞"]

    N --> O{"数据库是否可用?"}
    O -- "否" --> P["跳过得分保存和最高分查询<br/>同步阻塞: 耗时短"]
    O -- "是" --> Q["save_score(score)<br/>INSERT INTO snake_scores<br/>当前同步阻塞主游戏循环<br/>可异步: 推荐后台线程或任务队列"]

    Q --> R["MySQL commit / close<br/>当前同步阻塞，受数据库响应影响<br/>可异步: 适合后台执行"]
    R --> S["get_high_score()<br/>SELECT MAX(score)<br/>当前同步阻塞主游戏循环<br/>可异步: 可后台查询后回填"]
    S --> T["更新 self.high_score<br/>同步阻塞: 回到主线程更新游戏状态"]

    P --> U["Game.draw()<br/>结束界面显示本次得分和已有最高分<br/>同步阻塞"]
    T --> V["Game.draw()<br/>菜单/顶部信息栏/结束界面显示最新最高分<br/>同步阻塞"]
    M --> W["pygame.display.flip()<br/>同步阻塞: 刷新画面"]
    U --> W
    V --> W
    W --> X["clock.tick(speed)<br/>同步阻塞: 控制帧率"]

    classDef sync fill:#ffe7e7,stroke:#c62828,color:#111;
    classDef async fill:#e7f2ff,stroke:#1565c0,color:#111;
    classDef decision fill:#fff7d6,stroke:#8a6d00,color:#111;
    classDef done fill:#e8f5e9,stroke:#2e7d32,color:#111;

    class A,B,C,D,F,G,I,J,K,M,N,P,T,U,V,W,X sync;
    class Q,R,S async;
    class E,H,L,O decision;
