import time
import os
from datetime import datetime
import mysql.connector
from mysql.connector import Error

# ==================== 数据库配置 ====================
DB_CONFIG = {
    'host': 'localhost',
    'user': 'root',
    'password': '123456',
    'port': 3307,
    'database': 'clock_db'
}

# ==================== 数据库操作函数 ====================
def init_database():
    """初始化数据库和表（如果不存在则创建）"""
    try:
        # 先连接到MySQL服务器（不指定数据库）
        conn = mysql.connector.connect(
            host=DB_CONFIG['host'],
            user=DB_CONFIG['user'],
            password=DB_CONFIG['password'],
            port=DB_CONFIG['port']
        )
        cursor = conn.cursor()
        
        # 创建数据库（如果不存在）
        cursor.execute("CREATE DATABASE IF NOT EXISTS clock_db")
        cursor.execute("USE clock_db")
        
        # 创建表（如果不存在）
        create_table_sql = """
        CREATE TABLE IF NOT EXISTS clock_log (
            id INT AUTO_INCREMENT PRIMARY KEY,
            time_now_datetime DATETIME,
            created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        )
        """
        cursor.execute(create_table_sql)
        
        conn.commit()
        cursor.close()
        conn.close()
        print("✅ 数据库和表初始化成功！")
        return True
    except Error as e:
        print(f"❌ 数据库初始化失败: {e}")
        print("请检查：")
        print("1. MySQL服务是否已启动")
        print("2. 用户名和密码是否正确")
        print("3. 数据库 'clock_db' 是否已存在")
        return False

def insert_time_record(time_str):
    """向数据库插入一条时间记录"""
    try:
        conn = mysql.connector.connect(**DB_CONFIG)
        cursor = conn.cursor()
        
        sql = "INSERT INTO clock_log (time_now_datetime) VALUES (%s)"
        cursor.execute(sql, (time_str,))
        
        conn.commit()
        cursor.close()
        conn.close()
        return True
    except Error as e:
        print(f"⚠️ 插入数据库失败: {e}")
        return False

# ==================== 时钟核心功能 ====================
def get_centered_text(text):
    """计算居中显示所需的空格"""
    try:
        terminal_width = os.get_terminal_size().columns
    except OSError:
        terminal_width = 80
    
    padding = (terminal_width - len(text)) // 2
    if padding < 0:
        padding = 0
    
    return ' ' * padding + text

def main():
    """控制台实时时钟（带MySQL日志记录）"""
    print("=" * 60)
    print("   🕐 实时时钟 - 数据自动存入MySQL")
    print("=" * 60)
    print("按 Ctrl+C 退出程序\n")
    
    # 初始化数据库
    if not init_database():
        print("\n⚠️ 数据库初始化失败，将仅显示时钟，不记录日志")
        db_available = False
    else:
        db_available = True
        print("✅ 数据库已就绪，每0.5秒记录一条数据\n")
    
    # 记录插入计数
    insert_count = 0
    
    try:
        while True:
            # 1. 获取当前时间
            now = datetime.now()
            
            # 2. 格式化为字符串（包含毫秒）
            time_str = now.strftime("%Y-%m-%d %H:%M:%S") + f".{now.microsecond // 1000:03d}"
            
            # 3. 获取星期几
            weekday = now.strftime("%A")
            
            # 4. 组合成完整文本
            full_text = f"{time_str}  {weekday}"
            
            # 5. 居中处理
            display_text = get_centered_text(full_text)
            
            # 6. 打印并刷新（\r回到行首，不换行）
            print(f"\r{display_text}", end='', flush=True)
            
            # 7. 插入数据库（每0.5秒插入一条）
            if db_available and insert_count % 25 == 0:
                db_time_str = now.strftime("%Y-%m-%d %H:%M:%S")
                insert_time_record(db_time_str)
            
            insert_count += 1
            
            # 8. 暂停0.02秒
            time.sleep(0.02)
            
    except KeyboardInterrupt:
        print("\n\n🛑 时钟已停止")
        if db_available:
            print(f"📊 共向数据库插入了约 {insert_count // 25} 条记录")

# ==================== 程序入口 ====================
if __name__ == "__main__":
    main()