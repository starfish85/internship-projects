                flash(f'✅ 图片上传成功: {filename}', 'info')
            else:
                flash(f'❌ {error}', 'error')
                return redirect(url_for('admin_add'))
        else:
            image_url = request.form.get('image_url', '').strip()
            if image_url:
                image_path = image_url

        success, msg = add_product(name, price, stock, image_path, description)
        if success:
            flash(f'✅ {msg}', 'success')
            return redirect(url_for('admin'))
        else:
            flash(f'❌ {msg}', 'error')
            return redirect(url_for('admin_add'))

    menus = get_user_menus(session['user_id'])
    return render_template('admin_add.html', menus=menus)


