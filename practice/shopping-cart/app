    if not re.match(r'^[a-zA-Z0-9:_-]+$', code):
        flash('权限编码只能包含字母、数字、冒号、下划线和短横线', 'error')
        return redirect(url_for('permissions_list'))

    success, msg = upsert_permission(code, name, module, description)
    flash(msg, 'success' if success else 'error')
    return redirect(url_for('permissions_list'))


