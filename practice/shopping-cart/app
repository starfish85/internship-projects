def add_to_cart(product_id, quantity=1):
    conn = get_db_connection()
    if not conn:
        return False, "数据库连接失败", 0

    try:
        cursor = conn.cursor()

        cursor.execute("SELECT stock FROM products WHERE id = %s", (product_id,))
        stock_result = cursor.fetchone()
        if not stock_result:
            return False, "商品不存在", 0
        stock = stock_result[0]

        cursor.execute("SELECT id, quantity FROM cart WHERE product_id = %s", (product_id,))
        cart_item = cursor.fetchone()
        current_cart_qty = cart_item[1] if cart_item else 0

        new_total_qty = current_cart_qty + quantity

        if new_total_qty > stock:
            return False, f"库存不足！当前库存 {stock} 件，购物车已有 {current_cart_qty} 件，最多可再添加 {stock - current_cart_qty} 件", 0

        if cart_item:
            cursor.execute(
                "UPDATE cart SET quantity = %s WHERE id = %s",
                (new_total_qty, cart_item[0])
            )
        else:
            cursor.execute(
                "INSERT INTO cart (product_id, quantity) VALUES (%s, %s)",
                (product_id, quantity)
            )

        conn.commit()

        cursor.execute("SELECT SUM(quantity) FROM cart")
        count_result = cursor.fetchone()
        cart_count = count_result[0] if count_result[0] is not None else 0

        cursor.close()
        conn.close()
        return True, "已加入购物车", cart_count
    except Error as e:
        return False, f"操作失败: {e}", 0


def update_cart_quantity(cart_id, quantity):
    conn = get_db_connection()
    if not conn:
        return False, "数据库连接失败", None

    try:
        cursor = conn.cursor()

        cursor.execute("SELECT product_id FROM cart WHERE id = %s", (cart_id,))
        result = cursor.fetchone()
        if not result:
            return False, "购物车记录不存在", None
        product_id = result[0]

        cursor.execute("SELECT stock FROM products WHERE id = %s", (product_id,))
        stock_result = cursor.fetchone()
        stock = stock_result[0] if stock_result else 0

        if quantity > stock:
            return False, f"库存不足！当前库存 {stock} 件", None

        if quantity <= 0:
            cursor.execute("DELETE FROM cart WHERE id = %s", (cart_id,))
        else:
            cursor.execute(
                "UPDATE cart SET quantity = %s WHERE id = %s",
                (quantity, cart_id)
            )

        conn.commit()

        cursor.execute("SELECT SUM(quantity) FROM cart")
        count_result = cursor.fetchone()
        cart_count = count_result[0] if count_result[0] is not None else 0

        cursor.execute("""
            SELECT SUM(products.price * cart.quantity)
            FROM cart
            INNER JOIN products ON cart.product_id = products.id
        """)
        total_result = cursor.fetchone()
        total = float(total_result[0]) if total_result[0] is not None else 0.0

        cursor.execute("""
            SELECT products.price * cart.quantity
            FROM cart
            INNER JOIN products ON cart.product_id = products.id
            WHERE cart.id = %s
        """, (cart_id,))
        subtotal_result = cursor.fetchone()
        subtotal = float(subtotal_result[0]) if subtotal_result else 0.0

        cursor.close()
        conn.close()

        return True, "更新成功", {
            'cart_count': cart_count,
            'total': total,
            'subtotal': subtotal
        }
    except Error as e:
        return False, f"更新失败: {e}", None


