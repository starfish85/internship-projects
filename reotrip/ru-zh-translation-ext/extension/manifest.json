{
  "manifest_version": 3,
  "name": "Sputnik8 俄译中",
  "version": "1.0.0",
  "description": "Sputnik8.com 俄语站词典优先翻译（俄→简中），给运营/采购看站用。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Sputnik8 俄译中",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "permissions": ["storage"],
  "host_permissions": [
    "*://www.sputnik8.com/*",
    "*://sputnik8.com/*",
    "https://translate.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://www.sputnik8.com/*", "*://sputnik8.com/*"],
      "js": ["src/engine.js", "src/content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["data/*.json"],
      "matches": ["*://www.sputnik8.com/*", "*://sputnik8.com/*"]
    }
  ]
}
