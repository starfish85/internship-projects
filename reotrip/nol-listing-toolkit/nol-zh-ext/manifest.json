{
  "manifest_version": 3,
  "name": "NOL 合作后台 韩译中",
  "version": "1.3.1",
  "description": "NOL 合作后台简体覆盖（安全模式：只改文本节点，不破坏页面结构/接口）。",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://tour.triple.partners/*",
    "https://*.triple.partners/*",
    "https://translate.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://tour.triple.partners/*",
        "https://*.triple.partners/*"
      ],
      "js": [
        "src/bootstrap.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://tour.triple.partners/*",
        "https://*.triple.partners/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/dictionary_ko_zh.json",
        "src/remap_zh.json",
        "src/inject.js"
      ],
      "matches": [
        "https://tour.triple.partners/*",
        "https://*.triple.partners/*"
      ]
    }
  ],
  "action": {
    "default_title": "NOL 韩译中",
    "default_popup": "src/popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
